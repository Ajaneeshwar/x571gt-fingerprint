# Patched libfprint for ASUS VivoBook X571GT (ELAN7001 SPI, touchpad PID 04f3:3104)
# Based on the official Arch PKGBUILD; introspection/docs disabled (deps not installed).

pkgname=libfprint
pkgver=1.94.100
pkgrel=1.1
pkgdesc="Library for fingerprint readers (patched: ELAN7001 SPI PID 04f3:3104)"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  meson
  python-cairo
  python-gobject
  systemd
)
provides=(libfprint-2.so)
groups=(fprint)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#tag=v$pkgver"
        elanspi-x571gt.patch)
b2sums=('SKIP' 'SKIP')

prepare() {
  cd $pkgname
  patch -p1 < ../elanspi-x571gt.patch
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
    -D introspection=false
    -D doc=false
  )

  arch-meson $pkgname build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
