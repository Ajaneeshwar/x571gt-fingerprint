 {
@@ -1387,6 +1464,52 @@ elanspi_fp_frame_handler (FpiSsm *ssm, FpiDeviceElanSpi *self)
 {
   g_autofree struct fpi_frame *this_frame = NULL;
 
+  /* press-mode path: collect a stable full frame, no stitching */
+  if (self->sensor_id == 0xe)
+    {
+      switch (elanspi_guess_image (self, self->last_image))
+        {
+        case ELANSPI_GUESS_UNKNOWN:
+          fp_dbg ("<press> unknown, ignore...");
+          break;
+
+        case ELANSPI_GUESS_EMPTY:
+          self->fp_empty_counter += 1;
+          if (self->fp_empty_counter > 1)
+            {
+              if (self->press_frame_count >= 3)
+                {
+                  fp_dbg ("<press> finger lifted with usable frame, submitting");
+                  elanspi_fp_submit_press_frame (self);
+                }
+              else
+                {
+                  fp_dbg ("<press> finger lifted too early");
+                  self->press_frame_count = 0;
+                  fpi_image_device_retry_scan (FP_IMAGE_DEVICE (self), FP_DEVICE_RETRY_TOO_SHORT);
+                }
+              goto finish_capture;
+            }
+          break;
+
+        case ELANSPI_GUESS_FINGERPRINT:
+          self->fp_empty_counter = 0;
+          elanspi_correct_with_bg (self, self->last_image);
+          elanspi_process_press_frame (self, self->last_image, self->press_frame);
+          self->press_frame_count += 1;
+          if (self->press_frame_count >= ELANSPI_PRESS_FRAMES)
+            {
+              fp_dbg ("<press> have stable frame, submitting");
+              elanspi_fp_submit_press_frame (self);
+              goto finish_capture;
+            }
+          break;
+        }
+
+      fpi_ssm_jump_to_state_delayed (ssm, ELANSPI_FPCAPT_FP_CAPTURE, ELANSPI_HV_SENSOR_FRAME_DELAY);
+      return;
+    }
+
   switch (elanspi_guess_image (self, self->last_image))
     {
     case ELANSPI_GUESS_UNKNOWN:
@@ -1522,6 +1645,7 @@ elanspi_fp_capture_ssm_handler (FpiSsm *ssm, FpDevice *dev)
