+/* Press-mode capture for the eFSA80SC: the swipe/stitch pipeline produces
+ * speed-distorted strips that NBIS cannot match (genuine pairs score ~0),
+ * while single full 80x80 frames match reliably with SIGFM. Tone-map the
+ * whole frame (no rotation - SIGFM is rotation invariant, and no crop). */
+static void
+elanspi_process_press_frame (FpiDeviceElanSpi *self, const guint16 *data_in, guint8 *data_out)
+{
+  size_t frame_size = (size_t) self->sensor_width * self->sensor_height;
+  g_autofree guint16 *sorted = g_memdup2 (data_in, frame_size * 2);
+
+  qsort (sorted, frame_size, 2, cmp_u16);
+  guint16 lvl0 = sorted[0];
+  guint16 lvl1 = sorted[frame_size * 3 / 10];
+  guint16 lvl2 = sorted[frame_size * 65 / 100];
+  guint16 lvl3 = sorted[frame_size - 1];
+
+  lvl1 = MAX (lvl1, lvl0 + 1);
+  lvl2 = MAX (lvl2, lvl1 + 1);
+  lvl3 = MAX (lvl3, lvl2 + 1);
+
+  for (size_t i = 0; i < frame_size; i++)
+    {
+      guint16 px = data_in[i];
+      if (px < lvl0)
+        px = 0;
+      else if (px > lvl3)
+        px = 255;
+      else if (px < lvl1)
+        px = (px - lvl0) * 99 / (lvl1 - lvl0);
+      else if (px < lvl2)
+        px = 99 + ((px - lvl1) * 56 / (lvl2 - lvl1));
+      else
+        px = 155 + ((px - lvl2) * 100 / (lvl3 - lvl2));
+      data_out[i] = px;
+    }
+}
+
+#define ELANSPI_PRESS_FRAMES 10
+
+static void
+elanspi_fp_submit_press_frame (FpiDeviceElanSpi *self)
+{
+  FpImage *img = fp_image_new (self->sensor_width, self->sensor_height);
+
+  memcpy (img->data, self->press_frame,
+          (size_t) self->sensor_width * self->sensor_height);
+  img->flags |= FPI_IMAGE_PARTIAL | FPI_IMAGE_COLORS_INVERTED;
+
+  fpi_image_device_image_captured (FP_IMAGE_DEVICE (self), img);
+  self->press_frame_count = 0;
+}
